# CONFIG_NVS_SEC_KEY_PROTECT_NONE is not set
# Production/secure profile: derive NVS keys from an HMAC key in eFuse.
# Burn the HMAC key before flashing this profile. See README.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=0
CONFIG_WEBCAM_NVS_ENCRYPTION=y
CONFIG_WEBCAM_NVS_REQUIRE_ENCRYPTION=y
